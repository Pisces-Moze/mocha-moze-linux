	serial@70006000 {
		compatible = "nvidia,tegra124-uart", "nvidia,tegra20-uart";
		reg = <0x00 0x70006000 0x00 0x40>;
		reg-shift = <0x02>;
		interrupts = <0x00 0x24 0x04>;
		clocks = <0x03 0x06>;
		resets = <0x03 0x06>;
		dmas = <0x13 0x08 0x13 0x08>;
		dma-names = "rx", "tx";
		status = "disabled";
	};

	serial@70006040 {
		compatible = "nvidia,tegra124-uart", "nvidia,tegra20-uart";
		reg = <0x00 0x70006040 0x00 0x40>;
		reg-shift = <0x02>;
		interrupts = <0x00 0x25 0x04>;
		clocks = <0x03 0xc0>;
		resets = <0x03 0x07>;
		dmas = <0x13 0x09 0x13 0x09>;
		dma-names = "rx", "tx";
		status = "disabled";
	};

	serial@70006200 {
		compatible = "nvidia,tegra124-hsuart", "nvidia,tegra30-hsuart";
		reg = <0x00 0x70006200 0x00 0x40>;
		reg-shift = <0x02>;
		interrupts = <0x00 0x2e 0x04>;
		clocks = <0x03 0x37>;
		resets = <0x03 0x37>;
		dmas = <0x13 0x0a 0x13 0x0a>;
		dma-names = "rx", "tx";
		status = "disabled";
		uart-has-rtscts;

		bluetooth {
			compatible = "brcm,bcm43540-bt";
			max-speed = <0x2dc6c0>;
			shutdown-gpios = <0x0d 0x89 0x00>;
			device-wakeup-gpios = <0x0d 0xf1 0x00>;
			interrupt-parent = <0x0d>;
			interrupts = <0xa6 0x01>;
			interrupt-names = "host-wakeup";
		};
	};

	serial@70006300 {
		compatible = "nvidia,tegra124-uart", "nvidia,tegra20-uart";
		reg = <0x00 0x70006300 0x00 0x40>;
		reg-shift = <0x02>;
		interrupts = <0x00 0x5a 0x04>;
		clocks = <0x03 0x41>;
		resets = <0x03 0x41>;
		dmas = <0x13 0x13 0x13 0x13>;
		dma-names = "rx", "tx";
		status = "okay";
	};

	pwm@7000a000 {
		compatible = "nvidia,tegra124-pwm", "nvidia,tegra20-pwm";
		reg = <0x00 0x7000a000 0x00 0x100>;
		#pwm-cells = <0x02>;
		clocks = <0x03 0x11>;
		resets = <0x03 0x11>;
		reset-names = "pwm";
		status = "okay";
	};

	i2c@7000c000 {
		compatible = "nvidia,tegra124-i2c";
		reg = <0x00 0x7000c000 0x00 0x100>;
		interrupts = <0x00 0x26 0x04>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		clocks = <0x03 0x0c>;
		clock-names = "div-clk";
		resets = <0x03 0x0c>;
		reset-names = "i2c";
		dmas = <0x13 0x15 0x13 0x15>;
		dma-names = "rx", "tx";
		status = "okay";
		clock-frequency = <0x61a80>;

		backlight@2c {
			status = "okay";
			compatible = "xiaomi,mocha-miui-lp8556";
			reg = <0x2c>;
			dev-ctrl = [83];
			init-brt = [1f];
			led-en = [0f];
			phandle = <0x0e>;

			rom_98h {
				rom-addr = [98];
				rom-val = [80];
			};

			rom_9eh {
				rom-addr = [9e];
				rom-val = [21];
			};

			rom_a0h {
				rom-addr = [a0];
