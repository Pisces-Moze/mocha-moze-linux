		bq27520@55 {
			status = "okay";
			compatible = "ti,bq27520g4";
			reg = <0x55>;
		};

		charger@6b {
			ce-gpios = <0x32 0x07 0x01>;
			status = "okay";
			compatible = "ti,bq24192";
			reg = <0x6b>;
			interrupt-parent = <0x0d>;
			interrupts = <0x48 0x02>;
			monitored-battery = <0x14>;
			omit-battery-class;

			usb-otg-vbus {
