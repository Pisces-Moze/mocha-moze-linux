		reg = <0x00 0x700b0600 0x00 0x200>;
		interrupts = <0x00 0x1f 0x04>;
		clocks = <0x03 0x0f>;
		clock-names = "sdhci";
		resets = <0x03 0x0f>;
		reset-names = "sdhci";
		status = "okay";
		vmmc-supply = <0x1b>;
		vqmmc-supply = <0x1a>;
		bus-width = <0x08>;
		non-removable;
		max-frequency = <0x30a32c0>;
	};

	thermal-sensor@700e2000 {
		compatible = "nvidia,tegra124-soctherm";
		reg = <0x00 0x700e2000 0x00 0x600 0x00 0x60006000 0x00 0x400>;
		reg-names = "soctherm-reg", "car-reg";
		interrupts = <0x00 0x30 0x04 0x00 0x33 0x04>;
		interrupt-names = "thermal", "edp";
		clocks = <0x03 0x64 0x03 0x4e>;
		clock-names = "tsensor", "soctherm";
		resets = <0x03 0x4e>;
		reset-names = "soctherm";
		#thermal-sensor-cells = <0x01>;
		phandle = <0x2e>;

		throttle-cfgs {

			heavy {
				nvidia,priority = <0x64>;
				nvidia,cpu-throt-percent = <0x55>;
				nvidia,gpu-throt-level = <0x03>;
				#cooling-cells = <0x02>;
				phandle = <0x30>;
			};
		};
	};

	clock@70110000 {
		compatible = "nvidia,tegra124-dfll";
		reg = <0x00 0x70110000 0x00 0x100 0x00 0x70110000 0x00 0x100 0x00 0x70110100 0x00 0x100 0x00 0x70110200 0x00 0x100>;
		interrupts = <0x00 0x3e 0x04>;
		clocks = <0x03 0x109 0x03 0x108 0x03 0x2f>;
		clock-names = "soc", "ref", "i2c";
		resets = <0x03 0xc0>;
		reset-names = "dvco";
		#clock-cells = <0x00>;
		clock-output-names = "dfllCPU_out";
		nvidia,sample-rate = <0x30d4>;
		nvidia,droop-ctrl = <0xf00>;
		nvidia,force-mode = <0x01>;
		nvidia,cf = <0x0a>;
		nvidia,ci = <0x00>;
		nvidia,cg = <0x02>;
		status = "disabled";
		vdd-cpu-supply = <0x23>;
		nvidia,i2c-fs-rate = <0x61a80>;
		phandle = <0x29>;
	};

	ahub@70300000 {
		compatible = "nvidia,tegra124-ahub";
		reg = <0x00 0x70300000 0x00 0x200 0x00 0x70300800 0x00 0x800 0x00 0x70300200 0x00 0x600>;
		interrupts = <0x00 0x67 0x04>;
		clocks = <0x03 0x6a 0x03 0x6b>;
		clock-names = "d_audio", "apbif";
		resets = <0x03 0x6a 0x03 0x6b 0x03 0x1e 0x03 0x0b 0x03 0x12 0x03 0x65 0x03 0x66 0x03 0x6c 0x03 0x6d 0x03 0x6e 0x03 0x0a 0x03 0x99 0x03 0xb9 0x03 0x9a 0x03 0xb4 0x03 0xba 0x03 0xbb 0x03 0xbc 0x03 0xbd 0x03 0xbe 0x03 0xbf>;
		reset-names = "d_audio", "apbif", "i2s0", "i2s1", "i2s2", "i2s3", "i2s4", "dam0", "dam1", "dam2", "spdif", "amx", "amx1", "adx", "adx1", "afc0", "afc1", "afc2", "afc3", "afc4", "afc5";
		dmas = <0x13 0x01 0x13 0x01 0x13 0x02 0x13 0x02 0x13 0x03 0x13 0x03 0x13 0x04 0x13 0x04 0x13 0x06 0x13 0x06 0x13 0x07 0x13 0x07 0x13 0x0c 0x13 0x0c 0x13 0x0d 0x13 0x0d 0x13 0x0e 0x13 0x0e 0x13 0x1d 0x13 0x1d>;
		dma-names = "rx0", "tx0", "rx1", "tx1", "rx2", "tx2", "rx3", "tx3", "rx4", "tx4", "rx5", "tx5", "rx6", "tx6", "rx7", "tx7", "rx8", "tx8", "rx9", "tx9";
		ranges;
		#address-cells = <0x02>;
		#size-cells = <0x02>;

		i2s@70301000 {
			compatible = "nvidia,tegra124-i2s";
			reg = <0x00 0x70301000 0x00 0x100>;
			nvidia,ahub-cif-ids = <0x04 0x04>;
			clocks = <0x03 0x1e>;
			resets = <0x03 0x1e>;
			reset-names = "i2s";
			status = "disabled";
		};

		i2s@70301100 {
			compatible = "nvidia,tegra124-i2s";
			reg = <0x00 0x70301100 0x00 0x100>;
			nvidia,ahub-cif-ids = <0x05 0x05>;
			clocks = <0x03 0x0b>;
			resets = <0x03 0x0b>;
			reset-names = "i2s";
			status = "disabled";
		};

		i2s@70301200 {
			compatible = "nvidia,tegra124-i2s";
			reg = <0x00 0x70301200 0x00 0x100>;
			nvidia,ahub-cif-ids = <0x06 0x06>;
			clocks = <0x03 0x12>;
			resets = <0x03 0x12>;
			reset-names = "i2s";
			status = "disabled";
		};

		i2s@70301300 {
			compatible = "nvidia,tegra124-i2s";
			reg = <0x00 0x70301300 0x00 0x100>;
			nvidia,ahub-cif-ids = <0x07 0x07>;
			clocks = <0x03 0x65>;
			resets = <0x03 0x65>;
			reset-names = "i2s";
			status = "disabled";
		};

		i2s@70301400 {
			compatible = "nvidia,tegra124-i2s";
			reg = <0x00 0x70301400 0x00 0x100>;
			nvidia,ahub-cif-ids = <0x08 0x08>;
			clocks = <0x03 0x66>;
			resets = <0x03 0x66>;
			reset-names = "i2s";
			status = "disabled";
		};
	};

	usb@7d000000 {
		nvidia,pmic-vbus-session;
		extcon = <0x35>;
		compatible = "nvidia,tegra124-udc";
		reg = <0x00 0x7d000000 0x00 0x4000>;
		interrupts = <0x00 0x14 0x04>;
		phy_type = "utmi";
		clocks = <0x03 0x16>;
		resets = <0x03 0x16>;
		reset-names = "usb";
		nvidia,phy = <0x24>;
		status = "okay";
		dr_mode = "peripheral";
	};

	usb-phy@7d000000 {
		compatible = "nvidia,tegra124-usb-phy", "nvidia,tegra30-usb-phy";
		reg = <0x00 0x7d000000 0x00 0x4000 0x00 0x7d000000 0x00 0x4000>;
		interrupts = <0x00 0x14 0x04>;
		phy_type = "utmi";
		clocks = <0x03 0x16 0x03 0xde 0x03 0x16>;
		clock-names = "reg", "pll_u", "utmi-pads";
		resets = <0x03 0x16 0x03 0x16>;
		reset-names = "usb", "utmi-pads";
		#phy-cells = <0x00>;
		nvidia,hssync-start-delay = <0x00>;
		nvidia,idle-wait-delay = <0x11>;
		nvidia,elastic-limit = <0x10>;
		nvidia,term-range-adj = <0x06>;
		nvidia,xcvr-setup = <0x09>;
		nvidia,xcvr-lsfslew = <0x02>;
		nvidia,xcvr-lsrslew = <0x02>;
		nvidia,hssquelch-level = <0x02>;
		nvidia,hsdiscon-level = <0x05>;
		nvidia,xcvr-hsslew = <0x0c>;
		nvidia,has-utmi-pad-registers;
		nvidia,pmc = <0x25 0x00>;
		status = "okay";
		dr_mode = "peripheral";
		vbus-supply = <0x34>;
		phandle = <0x24>;
	};

	usb@7d004000 {
		compatible = "nvidia,tegra124-ehci", "nvidia,tegra30-ehci";
		reg = <0x00 0x7d004000 0x00 0x4000>;
		interrupts = <0x00 0x15 0x04>;
		phy_type = "utmi";
		clocks = <0x03 0x3a>;
		resets = <0x03 0x3a>;
		reset-names = "usb";
		nvidia,phy = <0x27>;
		status = "disabled";
	};

	usb-phy@7d004000 {
		compatible = "nvidia,tegra124-usb-phy", "nvidia,tegra30-usb-phy";
		reg = <0x00 0x7d004000 0x00 0x4000 0x00 0x7d000000 0x00 0x4000>;
		interrupts = <0x00 0x15 0x04>;
		phy_type = "utmi";
		clocks = <0x03 0x3a 0x03 0xde 0x03 0x16>;
		clock-names = "reg", "pll_u", "utmi-pads";
		resets = <0x03 0x3a 0x03 0x16>;
		reset-names = "usb", "utmi-pads";
		#phy-cells = <0x00>;
		nvidia,hssync-start-delay = <0x00>;
		nvidia,idle-wait-delay = <0x11>;
		nvidia,elastic-limit = <0x10>;
		nvidia,term-range-adj = <0x06>;
		nvidia,xcvr-setup = <0x09>;
		nvidia,xcvr-lsfslew = <0x00>;
		nvidia,xcvr-lsrslew = <0x03>;
		nvidia,hssquelch-level = <0x02>;
		nvidia,hsdiscon-level = <0x05>;
		nvidia,xcvr-hsslew = <0x0c>;
		nvidia,pmc = <0x25 0x01>;
		status = "disabled";
		phandle = <0x27>;
	};

	usb@7d008000 {
		compatible = "nvidia,tegra124-ehci", "nvidia,tegra30-ehci";
		reg = <0x00 0x7d008000 0x00 0x4000>;
		interrupts = <0x00 0x61 0x04>;
		phy_type = "utmi";
		clocks = <0x03 0x3b>;
		resets = <0x03 0x3b>;
		reset-names = "usb";
		nvidia,phy = <0x28>;
		status = "disabled";
	};

	usb-phy@7d008000 {
		compatible = "nvidia,tegra124-usb-phy", "nvidia,tegra30-usb-phy";
		reg = <0x00 0x7d008000 0x00 0x4000 0x00 0x7d000000 0x00 0x4000>;
		interrupts = <0x00 0x61 0x04>;
		phy_type = "utmi";
		clocks = <0x03 0x3b 0x03 0xde 0x03 0x16>;
		clock-names = "reg", "pll_u", "utmi-pads";
		resets = <0x03 0x3b 0x03 0x16>;
		reset-names = "usb", "utmi-pads";
		#phy-cells = <0x00>;
		nvidia,hssync-start-delay = <0x00>;
		nvidia,idle-wait-delay = <0x11>;
		nvidia,elastic-limit = <0x10>;
		nvidia,term-range-adj = <0x06>;
		nvidia,xcvr-setup = <0x09>;
		nvidia,xcvr-lsfslew = <0x00>;
		nvidia,xcvr-lsrslew = <0x03>;
		nvidia,hssquelch-level = <0x02>;
		nvidia,hsdiscon-level = <0x05>;
		nvidia,xcvr-hsslew = <0x0c>;
		nvidia,pmc = <0x25 0x02>;
		status = "disabled";
		phandle = <0x28>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a15";
			reg = <0x00>;
			clocks = <0x03 0x106 0x03 0x107 0x03 0xe3 0x03 0xd3 0x29>;
			clock-names = "cpu_g", "cpu_lp", "pll_x", "pll_p", "dfll";
			clock-latency = <0x493e0>;
			phandle = <0x2a>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a15";
			reg = <0x01>;
			phandle = <0x2b>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a15";
			reg = <0x02>;
			phandle = <0x2c>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a15";
			reg = <0x03>;
			phandle = <0x2d>;
		};
	};

	pmu {
		compatible = "arm,cortex-a15-pmu";
		interrupts = <0x00 0x90 0x04 0x00 0x91 0x04 0x00 0x92 0x04 0x00 0x93 0x04>;
		interrupt-affinity = <0x2a 0x2b 0x2c 0x2d>;
	};

	thermal-zones {

		cpu-thermal {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x2e 0x00>;

			trips {

				cpu-shutdown-trip {
					temperature = <0x19258>;
					hysteresis = <0x00>;
					type = "critical";
				};

				throttle-trip {
					temperature = <0x186a0>;
					hysteresis = <0x3e8>;
					type = "hot";
					phandle = <0x2f>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x2f>;
					cooling-device = <0x30 0x01 0x01>;
				};
			};
		};

		mem-thermal {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x2e 0x01>;

			trips {

				mem-shutdown-trip {
					temperature = <0x19258>;
					hysteresis = <0x00>;
					type = "critical";
				};

				mem-throttle-trip {
					temperature = <0x182b8>;
					hysteresis = <0x3e8>;
					type = "hot";
				};
			};

			cooling-maps {
			};
		};

		gpu-thermal {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x2e 0x02>;

			trips {

				gpu-shutdown-trip {
					temperature = <0x18a88>;
					hysteresis = <0x00>;
					type = "critical";
				};

				throttle-trip {
					temperature = <0x182b8>;
					hysteresis = <0x3e8>;
					type = "hot";
					phandle = <0x31>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x31>;
					cooling-device = <0x30 0x01 0x01>;
				};
			};
		};

		pllx-thermal {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x2e 0x03>;

			trips {

				pllx-shutdown-trip {
					temperature = <0x19258>;
					hysteresis = <0x00>;
					type = "critical";
				};

				pllx-throttle-trip {
					temperature = <0x182b8>;
					hysteresis = <0x3e8>;
					type = "hot";
				};
			};

			cooling-maps {
			};
		};
	};

	timer {
		compatible = "arm,armv7-timer";
		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
		interrupt-parent = <0x02>;
	};

	mipi@700e3000 {
		compatible = "nvidia,tegra124-mipi";
		reg = <0x00 0x700e3000 0x00 0x100>;
		clocks = <0x03 0x38>;
		#nvidia,mipi-calibrate-cells = <0x01>;
		status = "okay";
		phandle = <0x0a>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		status = "okay";

		power {
			label = "Power";
			gpios = <0x0d 0x80 0x01>;
			linux,code = <0x74>;
			wakeup-source;
		};

		volume_down {
			label = "Volume Down";
			gpios = <0x0d 0x87 0x01>;
			linux,code = <0x72>;
		};

		volume_up {
			label = "Volume Up";
			gpios = <0x0d 0x86 0x01>;
			linux,code = <0x73>;
		};

		hall_intr1 {
			label = "lid_back";
			gpios = <0x0d 0xb3 0x01>;
			linux,code = <0x12>;
			linux,input-type = <0x05>;
			wakeup-source;
		};

		hall_intr2 {
			label = "lid_front";
			gpios = <0x0d 0x45 0x01>;
			linux,code = <0x00>;
			linux,input-type = <0x05>;
			wakeup-source;
		};
	};

	aliases {
		mmc1 = "/mmc@700b0000";
		mmc2 = "/mmc@700b0400";
		mmc0 = "/mmc@700b0600";
		rtc0 = "/i2c@7000d000/tps65913@58";
		rtc1 = "/rtc@7000e000";
	};

	regulators {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		regulator@0 {
			compatible = "regulator-fixed";
			reg = <0x00>;
			regulator-name = "vdd_ac_bat";
			regulator-min-microvolt = <0x4c4b40>;
			regulator-max-microvolt = <0x4c4b40>;
			regulator-always-on;
		};

		regulator@1 {
			compatible = "regulator-fixed";
			reg = <0x01>;
			regulator-name = "usb0-vbus";
			regulator-min-microvolt = <0x4c4b40>;
			regulator-max-microvolt = <0x4c4b40>;
			gpio = <0x0d 0x6c 0x00>;
			enable-active-high;
			gpio-open-drain;
		};

		regulator@2 {
			compatible = "regulator-fixed";
			reg = <0x02>;
			regulator-name = "usb1-vbus";
			regulator-min-microvolt = <0x4c4b40>;
			regulator-max-microvolt = <0x4c4b40>;
			enable-active-high;
			gpio = <0x0d 0x6d 0x00>;
			gpio-open-drain;
			vin-supply = <0x19>;
		};

		regulator@3 {
			compatible = "regulator-fixed";
			reg = <0x03>;
			regulator-name = "usb2-vbus";
			regulator-min-microvolt = <0x4c4b40>;
			regulator-max-microvolt = <0x4c4b40>;
			enable-active-high;
			gpio = <0x0d 0xf9 0x00>;
			gpio-open-drain;
			vin-supply = <0x19>;
		};

		regulator@4 {
			compatible = "regulator-fixed";
			reg = <0x04>;
			regulator-name = "avdd-lcd-vsp";
			regulator-min-microvolt = <0x53ec60>;
			regulator-max-microvolt = <0x53ec60>;
			regulator-boot-on;
			gpio = <0x0d 0x44 0x00>;
			regulator-always-on;
			enable-active-high;
			phandle = <0x07>;
		};

		regulator@5 {
			compatible = "regulator-fixed";
			reg = <0x05>;
			regulator-name = "avdd-lcd-vsn";
			regulator-min-microvolt = <0x53ec60>;
			regulator-max-microvolt = <0x53ec60>;
			regulator-boot-on;
			gpio = <0x0d 0x92 0x00>;
			enable-active-high;
			phandle = <0x08>;
		};

		regulator@6 {
			compatible = "regulator-fixed";
			reg = <0x06>;
			regulator-name = "vdd-lcd";
			regulator-min-microvolt = <0x124f80>;
			regulator-max-microvolt = <0x124f80>;
			enable-active-high;
			vin-supply = <0x1a>;
		};

		regulator@7 {
			compatible = "regulator-fixed";
			reg = <0x07>;
			regulator-name = "ldoen";
			regulator-min-microvolt = <0x124f80>;
			regulator-max-microvolt = <0x124f80>;
			enable-active-high;
			gpio = <0x32 0x06 0x00>;
			vin-supply = <0x1a>;
		};

		regulator@8 {
			compatible = "regulator-fixed";
			reg = <0x08>;
			regulator-name = "en-lcd-bl";
			regulator-min-microvolt = <0x4c4b40>;
			regulator-max-microvolt = <0x4c4b40>;
			enable-active-high;
			gpio = <0x0d 0x3a 0x00>;
		};

		regulator@9 {
			compatible = "regulator-fixed";
			reg = <0x09>;
			regulator-name = "vdd-hdmi";
			regulator-min-microvolt = <0x4c4b40>;
			regulator-max-microvolt = <0x4c4b40>;
			enable-active-high;
			gpio = <0x0d 0x56 0x00>;
			vin-supply = <0x33>;
		};

		regulator@a {
			compatible = "regulator-fixed";
			reg = <0x0a>;
			regulator-name = "vdd-cam-1v8";
			regulator-min-microvolt = <0x1b7740>;
			regulator-max-microvolt = <0x1b7740>;
			enable-active-high;
			gpio = <0x32 0x01 0x00>;
			vin-supply = <0x1a>;
		};

		regulator@b {
			compatible = "regulator-fixed";
			reg = <0x0b>;
			regulator-name = "vdd-cam-1v2";
			regulator-min-microvolt = <0x124f80>;
			regulator-max-microvolt = <0x124f80>;
			enable-active-high;
			gpio = <0x32 0x02 0x00>;
			vin-supply = <0x1a>;
		};
	};

	battery {
		compatible = "simple-battery";
		precharge-current-microamp = <0x3e800>;
		charge-term-current-microamp = <0x1f400>;
		constant-charge-current-max-microamp = <0xf4240>;
		constant-charge-voltage-max-microvolt = <0x403580>;
		phandle = <0x14>;
	};

	chosen {
		ranges;
		#size-cells = <0x02>;
		#address-cells = <0x02>;

		framebuffer@f1700000 {
			status = "okay";
			format = "r5g6b5";
			stride = <0xc00>;
			height = <0x800>;
			width = <0x600>;
			reg = <0x00 0xf1700000 0x00 0x600000>;
			compatible = "simple-framebuffer";
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		pstore@fd400000 {
			reg = <0x00 0xfd400000 0x00 0x200000>;
			compatible = "ramoops";
			record-size = <0x10000>;
			console-size = <0x80000>;
			pmsg-size = <0x40000>;
			ftrace-size = <0x80000>;
			rtrace-size = <0x80000>;
			no-map;
			status = "okay";
		};
	};

	clocks {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		clock@0 {
			compatible = "fixed-clock";
			reg = <0x00>;
			#clock-cells = <0x00>;
			clock-frequency = <0x8000>;
			phandle = <0x1c>;
		};
	};

	psci {
		compatible = "arm,psci";
		method = "smc";
		cpu_suspend = <0x84000001>;
		cpu_on = <0x84000003>;
		status = "disabled";
	};

	regulator-sd-slot {
		compatible = "regulator-fixed";
		regulator-name = "mocha-sd-slot-3v3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		vin-supply = <0x1b>;
		gpio = <0x0d 0x88 0x00>;
		enable-active-high;
		startup-delay-us = <0x1388>;
		phandle = <0x21>;
	};

	wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <0x0d 0xbf 0x01>;
		post-power-on-delay-ms = <0xc8>;
		phandle = <0x20>;
	};
};
