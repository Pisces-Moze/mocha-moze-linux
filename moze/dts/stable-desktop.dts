			};

			rom_a2h {
				rom-addr = [a2];
				rom-val = [20];
			};

			rom_a3h {
				rom-addr = [a3];
				rom-val = [00];
			};

			rom_a4h {
				rom-addr = [a4];
				rom-val = [72];
			};

			rom_a5h {
				rom-addr = [a5];
				rom-val = [24];
			};

			rom_a6h {
				rom-addr = [a6];
