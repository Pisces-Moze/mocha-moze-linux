		tps65913@58 {
			status = "okay";
			compatible = "ti,palmas";
			reg = <0x58>;
			interrupts = <0x00 0x56 0x04>;
			#interrupt-cells = <0x02>;
			interrupt-controller;
			ti,system-power-controller;
			phandle = <0x16>;

			gpio {
				status = "okay";
				compatible = "ti,palmas-gpio";
				gpio-controller;
				#gpio-cells = <0x02>;
				phandle = <0x32>;
			};

			rtc {
				status = "disabled";
				compatible = "ti,palmas-rtc";
				interrupt-parent = <0x16>;
				interrupts = <0x08 0x00>;
			};

			pinmux {
				status = "disabled";
				compatible = "ti,tps65913-pinctrl";
				pinctrl-names = "default";
				pinctrl-0 = <0x17>;

				pinmux {
					phandle = <0x17>;

					powergood {
						pins = "powergood";
						function = "powergood";
					};

					vac {
						pins = "vac";
						function = "vac";
					};

					pin_gpio0 {
						pins = "gpio0";
						function = "id";
						bias-pull-up;
					};

					pin_gpio1 {
						pins = "gpio1";
						function = "gpio";
					};

					pin_gpio6 {
						pins = "gpio2", "gpio3", "gpio4", "gpio6", "gpio7";
						function = "gpio";
					};

					pin_gpio5 {
						pins = "gpio5";
						function = "clk32kgaudio";
					};
				};
			};

			extcon {
				phandle = <0x35>;
				status = "okay";
				compatible = "ti,palmas-usb-vid";
				ti,wakeup;
				#extcon-cells = <0x01>;
				ti,enable-vbus-detection;
			};

			clk32kgaudio {
				status = "disabled";
				compatible = "ti,palmas-clk32kgaudio";
				#clock-cells = <0x00>;
			};

			clk32kg {
				status = "disabled";
				compatible = "ti,palmas-clk32kg";
				#clock-cells = <0x00>;
			};

			pmic {
				status = "okay";
				compatible = "ti,tps65913-pmic", "ti,palmas-pmic";
				ldo1-in-supply = <0x18>;
				ldo2-in-supply = <0x18>;
				ldo3-in-supply = <0x19>;
				ldo5-in-supply = <0x1a>;
				ldo6-in-supply = <0x1b>;
				ldo7-in-supply = <0x1b>;
				ldo9-in-supply = <0x1b>;
				ldoln-in-supply = <0x19>;
				smps10-out2-supply = <0x19>;

				regulators {

					smps123 {
						regulator-name = "vdd-cpu";
						regulator-min-microvolt = <0xaae60>;
						regulator-max-microvolt = <0x155cc0>;
						regulator-always-on;
						regulator-boot-on;
						ti,config-flags = <0x08>;
						phandle = <0x23>;
					};

					smps45 {
						regulator-name = "vdd-gpu";
						regulator-min-microvolt = <0xaae60>;
						regulator-max-microvolt = <0x155cc0>;
						regulator-init-microvolt = <0xf4240>;
						regulator-boot-on;
						phandle = <0x0f>;
					};

					smps6 {
						regulator-name = "vddio-ddr";
						regulator-always-on;
						regulator-boot-on;
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x124f80>;
						phandle = <0x18>;
					};

					smps7 {
						regulator-name = "vdd-core";
						regulator-min-microvolt = <0xaae60>;
						regulator-max-microvolt = <0x155cc0>;
						regulator-always-on;
						regulator-boot-on;
					};

					smps8 {
						regulator-name = "vdd-1v8";
						regulator-always-on;
						regulator-boot-on;
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						phandle = <0x1a>;
					};

					smps9 {
						regulator-name = "vdd-snsr";
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-always-on;
						regulator-boot-on;
						phandle = <0x1b>;
					};

					smps10_out1 {
						regulator-name = "vdd-out1-5v0";
						regulator-min-microvolt = <0x4c4b40>;
						regulator-max-microvolt = <0x4c4b40>;
						regulator-always-on;
						regulator-boot-on;
						phandle = <0x33>;
					};

					smps10_out2 {
						regulator-name = "vdd-out2-5v0";
						regulator-min-microvolt = <0x4c4b40>;
						regulator-max-microvolt = <0x4c4b40>;
						phandle = <0x19>;
					};

					ldo1 {
						regulator-name = "avdd-pll";
