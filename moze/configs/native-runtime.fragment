# Opt-in runtime-power validation profile. Keep the accepted native baseline.
CONFIG_LOCALVERSION="-moze.1-native-runtime"
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_TEGRA124_CPUFREQ=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_TEGRA_CPUIDLE=y
# Normal eMMC boot must retain the same idle exclusion used in RAM trials.
# Deep Tegra idle remains a separate opt-in validation, not a desktop default.
CONFIG_CMDLINE="cpuidle.off=1"
CONFIG_CMDLINE_EXTEND=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=n
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# BlueZ HID/HOGP input and AVRCP media buttons.
CONFIG_UHID=m
CONFIG_INPUT_UINPUT=m
